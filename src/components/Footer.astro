---
import Reveal from './Reveal.astro';
import SplitText from './SplitText.astro';
import { contact, socials, clients, footerExpertises, serviceSlugs, site } from '../data/site';
import { url } from '../lib/url';
---

<footer class="footer" id="contact">
  <div class="wrap">
    <div class="footer__cols">
      <Reveal class="footer__col footer__col--contact">
        <p class="label">Infos &amp; contacts</p>
        <ul class="footer__direct">
          <li>{contact.name}</li>
          <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
          <li><a href={`tel:${contact.phoneHref}`}>{contact.phoneDisplay}</a></li>
        </ul>
      </Reveal>

      <Reveal class="footer__col footer__col--bio" delay={0.06}>
        <SplitText
          as="p"
          text={contact.bio}
          preset="body"
          emphasis={contact.bioEmphasis}
          class="footer__bio"
        />
      </Reveal>

      <Reveal class="footer__col" delay={0.12}>
        <p class="label">Expertises</p>
        <ul class="footer__list">
          {
            footerExpertises.map((label) => {
              const slug = serviceSlugs[label];
              return (
                <li>
                  {slug ? <a href={url(`/projects/expertises/${slug}`)}>{label}</a> : <span>{label}</span>}
                </li>
              );
            })
          }
        </ul>
      </Reveal>

      <Reveal class="footer__col" delay={0.18}>
        <p class="label">Clients</p>
        <ul class="footer__list">
          {clients.map((c) => <li><span>{c}</span></li>)}
        </ul>
      </Reveal>
    </div>

    <div class="footer__bottom">
      <ul class="footer__socials">
        {
          socials.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a>
            </li>
          ))
        }
      </ul>
      <p class="footer__legal">
        <span class="footer__mark">ēbs:projects</span> ©{site.copyrightYear}
      </p>
    </div>
  </div>
</footer>

<style>
  .footer { padding-block: clamp(5rem, 12vw, 11rem) 2.5rem; }

  .footer__cols {
    display: grid;
    grid-template-columns: 1.15fr 1.4fr 1fr 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .footer__col .label { margin-bottom: 2.5rem; }

  /* --- Contact block ------------------------------------------------------ */

  .footer__direct {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
    font-size: 1rem;
  }

  .footer__direct a {
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.45s var(--ease);
    word-break: break-word;
  }
  .footer__direct a:hover { background-size: 100% 1px; }

  /* --- Bio ---------------------------------------------------------------- */

  .footer__bio {
    display: block;
    font-size: 0.9375rem;
    font-weight: 300;
    line-height: 1.55;
    color: var(--fg-dim);
    max-width: 34ch;
  }

  /* --- Lists -------------------------------------------------------------- */

  .footer__list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.9375rem;
  }

  .footer__list li { color: var(--fg); }
  .footer__list a { transition: opacity 0.3s var(--ease); }
  .footer__list a:hover { opacity: 0.6; }

  /* --- Bottom bar --------------------------------------------------------- */

  .footer__bottom {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
    margin-top: clamp(4rem, 10vw, 8.5rem);
  }

  .footer__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem;
  }

  .footer__socials a {
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    transition: opacity 0.3s var(--ease);
  }
  .footer__socials a:hover { opacity: 0.6; }

  .footer__legal {
    font-size: var(--fs-label);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .footer__mark { font-weight: 600; }

  @media (max-width: 1199.98px) {
    .footer__cols { grid-template-columns: 1fr 1fr; row-gap: 3.5rem; }
  }

  @media (max-width: 809.98px) {
    .footer__cols { grid-template-columns: minmax(0, 1fr); row-gap: 3rem; }
    .footer__col .label { margin-bottom: 1.25rem; }
    .footer__direct { gap: 0.6rem; }
    .footer__bottom { flex-direction: column; align-items: flex-start; gap: 1.25rem; }
  }
</style>
