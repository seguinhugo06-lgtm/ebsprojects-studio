---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Two card shapes, both measured off the original site at a 1440px viewport:
 *
 *  stacked  — the home page's "Selected projects". Image at 613×476 (1.287),
 *             title below it at 18px in sentence case. No services.
 *  related  — "More projects" at the foot of a project page: a portrait
 *             crop at 414x517 (0.800), three across with a 12px gap.
 *  overlay  — the listing and expertise pages. Image at 613×535 (1.146) with
 *             no caption until hover, when the title (15px, uppercase) fades
 *             in bottom-left and the services (15px, sentence case)
 *             bottom-right, both inset 16px. No scrim, no image movement.
 */
interface Props {
  href: string;
  title: string;
  services: readonly string[];
  image: ImageMetadata;
  variant?: 'stacked' | 'overlay' | 'related';
  /** Stacked cards in "More projects" also list the services. */
  showServices?: boolean;
  /** Rendered width hint for srcset generation. */
  sizes?: string;
  /** Eager-load the first cards so the grid does not pop in. */
  priority?: boolean;
}

const {
  href,
  title,
  services,
  image,
  variant = 'overlay',
  showServices = false,
  sizes = '(max-width: 809px) 96vw, 43vw',
  priority = false,
} = Astro.props;
---

<a class:list={['card', `card--${variant}`]} href={href}>
  <div class="card__media">
    <Image
      src={image}
      alt={title}
      widths={[500, 800, 1240, 1800, 2400]}
      quality={85}
      sizes={sizes}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
    />

    {
      variant !== 'stacked' && (
        <span class="card__overlay">
          <span class="card__over-title">{title}</span>
          <span class="card__over-services">
            {services.map((s) => (
              <span>{s}</span>
            ))}
          </span>
        </span>
      )
    }
  </div>

  {
    variant === 'stacked' && (
      <div class="card__caption">
        <h3 class="card__title">{title}</h3>
        {showServices && <p class="card__services">{services.join(', ')}</p>}
      </div>
    )
  }
</a>

<style>
  .card { display: block; }

  .card__media {
    position: relative;
    overflow: hidden;
    background: var(--bg-raised);
  }

  .card--stacked .card__media { aspect-ratio: 613 / 476; }
  .card--overlay .card__media { aspect-ratio: 613 / 535; }
  .card--related .card__media { aspect-ratio: 414 / 517; }

  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* --- Stacked caption ---------------------------------------------------- */

  .card__caption { margin-top: 20px; }

  .card__title {
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .card__services {
    margin-top: 0.3rem;
    font-size: 0.9375rem;
    color: var(--fg-dim);
  }

  /* --- Hover overlay ------------------------------------------------------ */

  .card__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding: 16px;
    opacity: 0;
    transition: opacity 0.45s var(--spring-smooth);
  }

  .card:hover .card__overlay,
  .card:focus-visible .card__overlay { opacity: 1; }

  .card__over-title,
  .card__over-services {
    font-size: 0.9375rem;
    line-height: 1.35;
    color: var(--fg);
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.55);
  }

  .card__over-title { text-transform: uppercase; }

  /* One service per line, right-aligned, as on the original. */
  .card__over-services {
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
  }

  @media (max-width: 809.98px) {
    /* No hover on touch: show the caption under the image instead. */
    .card__overlay {
      position: static;
      opacity: 1;
      padding: 16px 0 0;
    }
    .card__over-title,
    .card__over-services { text-shadow: none; }
  }
</style>
