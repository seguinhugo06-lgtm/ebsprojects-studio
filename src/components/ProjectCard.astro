---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  title: string;
  services: readonly string[];
  image: ImageMetadata;
  /** Rendered width hint for srcset generation. */
  sizes?: string;
  /** Eager-load the first cards so the grid does not pop in. */
  priority?: boolean;
}

const {
  href,
  title,
  services,
  image,
  sizes = '(max-width: 760px) 92vw, (max-width: 1360px) 46vw, 613px',
  priority = false,
} = Astro.props;
---

<a class="card" href={href}>
  <div class="card__media">
    <Image
      src={image}
      alt={title}
      widths={[480, 760, 1226]}
      quality={72}
      sizes={sizes}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
    />
  </div>
  <div class="card__meta">
    <h3 class="card__title">{title}</h3>
    <p class="card__services">
      {services.map((s) => <span>{s}</span>)}
    </p>
  </div>
</a>

<style>
  .card { display: block; }

  .card__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 613 / 535;
    background: var(--bg-raised);
    border-radius: 2px;
  }

  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.001);
    transition: transform 0.9s var(--ease), filter 0.6s var(--ease);
  }

  .card:hover .card__media :global(img),
  .card:focus-visible .card__media :global(img) {
    transform: scale(1.045);
  }

  .card__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.25rem;
    padding-top: 1rem;
  }

  .card__title {
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .card__services {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.35rem 0.75rem;
    font-size: var(--fs-label);
    letter-spacing: 0.02em;
    color: var(--fg-dim);
    text-align: right;
    flex: none;
    max-width: 45%;
  }

  .card__services span:not(:last-child)::after {
    content: ' /';
  }

  @media (max-width: 560px) {
    .card__meta { flex-direction: column; gap: 0.35rem; }
    .card__services { justify-content: flex-start; text-align: left; max-width: none; }
  }
</style>
