---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Reveal from '../components/Reveal.astro';
import { site, process, serviceSlugs } from '../data/site';

const projects = await getCollection('projects');
const byOrder = [...projects].sort((a, b) => a.data.order - b.data.order);

const featured = byOrder.filter((p) => p.data.featured).slice(0, 4);

const expertises = (await getCollection('expertises')).sort((a, b) => a.data.order - b.data.order);
const expertiseBodies = await Promise.all(
  expertises.map(async (e) => ({ entry: e, Content: (await render(e)).Content }))
);

/** The full-bleed showcase block near the foot of the page. */
const showcase = await getEntry('projects', 'epeda-collection-dedicace');
---

<Base>
  {/* ---------------------------------------------------------------- Hero */}
  <section class="hero">
    <div class="wrap hero__inner">
      <h1 class="display hero__title">
        <span class="hero__line">Creative</span>
        <span class="hero__line">Design Studio</span>
      </h1>
      <p class="hero__sub">{site.subtitle}</p>
    </div>

    <a class="badge" href="#work" aria-label="Faire défiler vers les projets">
      <svg class="badge__ring" viewBox="0 0 100 100" aria-hidden="true">
        <defs>
          <path id="badge-arc" d="M50,50 m-34,0 a34,34 0 1,1 68,0 a34,34 0 1,1 -68,0" />
        </defs>
        <text>
          <textPath href="#badge-arc" startOffset="0">
            Welcome • Discover • Scroll •&nbsp;
          </textPath>
        </text>
      </svg>
      <span class="badge__arrow" aria-hidden="true">
        <svg width="12" height="14" viewBox="0 0 12 14" fill="none">
          <path d="M6 0v12M1 7.5l5 5 5-5" stroke="currentColor" stroke-width="1.3" />
        </svg>
      </span>
    </a>
  </section>

  {/* ----------------------------------------------------- Selected work */}
  <section class="section" id="work">
    <div class="wrap">
      <Reveal class="section-head">
        <h2 class="label">Selected projects</h2>
        <a class="link" href="/projects">
          Voir tous les projets
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <path d="M1 9L9 1M9 1H3M9 1v6" stroke="currentColor" stroke-width="1.2" />
          </svg>
        </a>
      </Reveal>

      <div class="grid">
        {
          featured.map((p, i) => (
            <Reveal delay={(i % 2) * 0.08}>
              <ProjectCard
                href={`/projects/${p.id}`}
                title={p.data.title}
                services={p.data.services}
                image={p.data.cover}
                priority={i < 2}
              />
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------- Expertises */}
  <section class="section expertises" id="expertises">
    <div class="wrap">
      <Reveal class="section-head">
        <h2 class="label">Expertises</h2>
        <p class="expertises__hint">Faites défiler →</p>
      </Reveal>
    </div>

    <ul class="rail" data-rail>
      {
        expertiseBodies.map(({ entry, Content }) => (
          <li class="rail__item">
            <a class="expertise" href={`/projects/expertises/${entry.id}`}>
              <p class="label expertise__index">{entry.data.index}</p>
              <h3 class="expertise__title">{entry.data.title}</h3>
              <div class="expertise__body">
                <Content />
              </div>
              <span class="expertise__more link">
                Voir les projets
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                  <path d="M1 9L9 1M9 1H3M9 1v6" stroke="currentColor" stroke-width="1.2" />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {/* ---------------------------------------------------------- Process */}
  <section class="section" id="process">
    <div class="wrap">
      <Reveal>
        <h2 class="title process__heading">Comment se déroule un projet&nbsp;?</h2>
      </Reveal>

      <div class="process">
        {
          process.map((step, i) => (
            <Reveal delay={i * 0.04}>
              <details class="step" name="process" open={i === 0}>
                <summary class="step__summary">
                  <span class="step__index">{String(i + 1).padStart(2, '0')}</span>
                  <span class="step__title">{step.title}</span>
                  <span class="step__icon" aria-hidden="true" />
                </summary>
                <div class="step__panel">
                  <p class="lead">{step.body}</p>
                </div>
              </details>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  {/* --------------------------------------------------------- Showcase */}
  {
    showcase && (
      <section class="showcase">
        <div class="wrap">
          <Reveal>
            <a class="showcase__link" href={`/projects/${showcase.id}`}>
              <div class="showcase__media">
                <Image
                  src={showcase.data.gallery[0]}
                  alt={showcase.data.title}
                  widths={[760, 1280, 1920]}
                  quality={74}
                  sizes="(max-width: 1360px) 100vw, 1280px"
                  loading="lazy"
                />
              </div>
              <div class="showcase__meta">
                <h2 class="showcase__title">{showcase.data.title}</h2>
                <p class="showcase__services">
                  {showcase.data.services.map((s) => (
                    <span>{s}</span>
                  ))}
                </p>
              </div>
            </a>
          </Reveal>

          <Reveal class="showcase__cta">
            <a class="pill" href="/projects">
              <span class="dot" aria-hidden="true" />
              Voir tous les projets
            </a>
          </Reveal>
        </div>
      </section>
    )
  }
</Base>

<style>
  /* --- Hero -------------------------------------------------------------- */

  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100svh;
    padding-block: 8rem 7rem;
  }

  .hero__inner { text-align: center; }

  .hero__title {
    display: flex;
    flex-direction: column;
  }

  .hero__line {
    display: block;
    /* Reveal each line from behind a mask on load. */
    animation: rise 1.1s var(--ease) backwards;
  }
  .hero__line:nth-child(2) { animation-delay: 0.12s; }

  .hero__sub {
    margin-top: clamp(1rem, 2vw, 1.5rem);
    font-size: clamp(0.75rem, 1.05vw, 0.9375rem);
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
    animation: rise 1.1s var(--ease) 0.26s backwards;
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(0.5em); }
    to { opacity: 1; transform: none; }
  }

  .badge {
    position: absolute;
    left: 50%;
    bottom: clamp(2rem, 5vh, 3.5rem);
    translate: -50% 0;
    display: grid;
    place-items: center;
    width: 104px;
    height: 104px;
    color: var(--fg-muted);
    transition: color 0.4s var(--ease);
    animation: rise 1.1s var(--ease) 0.5s backwards;
  }
  .badge:hover { color: var(--fg); }

  .badge__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: spin 18s linear infinite;
  }

  .badge__ring text {
    font-size: 8px;
    letter-spacing: 0.205em;
    text-transform: uppercase;
    fill: currentColor;
  }

  .badge__arrow {
    display: grid;
    place-items: center;
    width: 12px;
    height: 14px;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .badge__ring { animation: none; }
  }

  /* --- Grid -------------------------------------------------------------- */

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 4vw, 3.5rem) var(--gap);
  }

  @media (max-width: 760px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
  }

  /* --- Expertises rail --------------------------------------------------- */

  .expertises__hint {
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-dim);
  }

  .rail {
    display: flex;
    gap: var(--gap);
    padding-inline: var(--gutter);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
    /* Let the last card rest against the gutter. */
    padding-bottom: 1.25rem;
  }

  .rail::-webkit-scrollbar { height: 2px; }
  .rail::-webkit-scrollbar-thumb { background: var(--line); }

  .rail__item {
    flex: 0 0 clamp(255px, 26vw, 320px);
    scroll-snap-align: start;
  }

  .expertise {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    height: 100%;
    padding: 1.5rem 1.4rem 1.4rem;
    background: var(--surface);
    border: 1px solid var(--line-soft);
    border-radius: 3px;
    transition: background-color 0.4s var(--ease), border-color 0.4s var(--ease),
      transform 0.5s var(--ease);
  }

  .expertise:hover {
    background: var(--surface-hover);
    border-color: var(--line);
    transform: translateY(-3px);
  }

  .expertise__title {
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .expertise__body {
    font-size: 0.875rem;
    font-weight: 300;
    line-height: 1.65;
    color: var(--fg-muted);
    flex: 1;
  }

  .expertise__more { margin-top: 0.35rem; align-self: flex-start; }
  .expertise:hover .expertise__more { background-size: 100% 1px; }

  /* --- Process ----------------------------------------------------------- */

  .process__heading {
    max-width: 16ch;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .process { border-top: 1px solid var(--line-soft); }

  .step { border-bottom: 1px solid var(--line-soft); }

  .step__summary {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding-block: clamp(1.15rem, 2.2vw, 1.6rem);
    cursor: pointer;
    list-style: none;
    transition: color 0.3s var(--ease);
  }
  .step__summary::-webkit-details-marker { display: none; }
  .step__summary:hover { color: var(--fg); }

  .step__index {
    flex: none;
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    color: var(--fg-dim);
  }

  .step__title {
    flex: 1;
    font-size: clamp(1rem, 1.9vw, 1.4rem);
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .step__icon {
    position: relative;
    flex: none;
    width: 13px;
    height: 13px;
    color: var(--fg-muted);
  }
  .step__icon::before,
  .step__icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 1.4px;
    background: currentColor;
    transition: transform 0.4s var(--ease);
  }
  .step__icon::after { transform: rotate(90deg); }
  .step[open] .step__icon::after { transform: rotate(0deg); }

  .step__panel {
    padding-bottom: clamp(1.25rem, 2.5vw, 1.85rem);
    padding-left: calc(2ch + clamp(1rem, 3vw, 2.5rem));
    max-width: 68ch;
  }

  @media (max-width: 560px) {
    .step__panel { padding-left: 0; }
  }

  /* --- Showcase ---------------------------------------------------------- */

  .showcase { padding-bottom: var(--section-y); }

  .showcase__media {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--bg-raised);
    border-radius: 2px;
  }

  .showcase__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--ease);
  }
  .showcase__link:hover .showcase__media :global(img) { transform: scale(1.035); }

  .showcase__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 1.1rem;
  }

  .showcase__title {
    font-size: clamp(1.05rem, 2vw, 1.5rem);
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .showcase__services {
    display: flex;
    gap: 0.75rem;
    font-size: var(--fs-label);
    color: var(--fg-dim);
  }
  .showcase__services span:not(:last-child)::after { content: ' /'; }

  .showcase__cta {
    display: flex;
    justify-content: center;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
</style>

<script>
  // Horizontal rails should respond to a normal vertical wheel gesture.
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  if (rail && window.matchMedia('(pointer: fine)').matches) {
    rail.addEventListener(
      'wheel',
      (e) => {
        if (Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return;
        const atStart = rail.scrollLeft <= 0;
        const atEnd = Math.ceil(rail.scrollLeft + rail.clientWidth) >= rail.scrollWidth;
        // Let the page keep scrolling once the rail reaches either end.
        if ((atStart && e.deltaY < 0) || (atEnd && e.deltaY > 0)) return;
        e.preventDefault();
        rail.scrollLeft += e.deltaY;
      },
      { passive: false }
    );
  }
</script>
