---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Reveal from '../components/Reveal.astro';
import SplitText from '../components/SplitText.astro';
import ImageTrail from '../components/ImageTrail.astro';
import { site, process, serviceSlugs } from '../data/site';
import { url } from '../lib/url';

const projects = await getCollection('projects');
const byOrder = [...projects].sort((a, b) => a.data.order - b.data.order);

const featured = byOrder.filter((p) => p.data.featured).slice(0, 4);

const expertises = (await getCollection('expertises')).sort((a, b) => a.data.order - b.data.order);
const expertiseBodies = await Promise.all(
  expertises.map(async (e) => ({ entry: e, Content: (await render(e)).Content }))
);

/** The auto-playing showcase near the foot of the page — three slides,
    matching the original. */
const showcaseSlugs = ['adidas-collection-prophere', 'beer-factory', 'epeda-collection-dedicace'];
const showcase = showcaseSlugs
  .map((slug) => byOrder.find((p) => p.id === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
---

<Base>
  {/* ---------------------------------------------------------------- Hero */}
  <section class="hero">
    <ImageTrail />

    <div class="wrap hero__inner">
      <h1 class="display hero__title">
        <SplitText text="Creative" preset="heroTitle" class="hero__line" />
        <SplitText text="Design Studio" preset="heroTitle" indexOffset={1} class="hero__line" />
      </h1>
      <p class="hero__sub"><SplitText text={site.subtitle} preset="heroSubtitle" /></p>
    </div>

    <a class="badge" href="#work" aria-label="Faire défiler vers les projets">
      <svg class="badge__ring" viewBox="0 0 100 100" aria-hidden="true">
        <defs>
          <path id="badge-arc" d="M50,50 m-34,0 a34,34 0 1,1 68,0 a34,34 0 1,1 -68,0" />
        </defs>
        <text>
          <textPath href="#badge-arc" startOffset="0">
            Welcolme • Discover • Scroll •&nbsp;
          </textPath>
        </text>
      </svg>
    </a>
  </section>

  {/* ----------------------------------------------------- Selected work */}
  <section class="section" id="work">
    <div class="wrap">
      <Reveal class="section-head">
        <SplitText as="h2" text="Selected projects" class="label" />
        <a class="link" href={url('/projects')}>
          Voir tous les projets
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <path d="M1 9L9 1M9 1H3M9 1v6" stroke="currentColor" stroke-width="1.2" />
          </svg>
        </a>
      </Reveal>

      <div class="grid">
        {
          featured.map((p, i) => (
            <Reveal delay={(i % 2) * 0.08}>
              <ProjectCard
                href={url(`/projects/${p.id}`)}
                title={p.data.title}
                services={p.data.services}
                image={p.data.cover}
                variant="stacked"
                priority={i < 2}
              />
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------- Expertises */}
  <section class="section expertises r-sect" id="expertises" data-reveal>
    <div class="wrap">
      <Reveal class="section-head">
        <SplitText as="h2" text="Expertises" class="label" />
        <p class="expertises__hint">Faites défiler →</p>
      </Reveal>
    </div>

    <div class="rail-wrap">
      <ul class="rail" data-rail>
        {
          expertiseBodies.map(({ entry, Content }) => (
            <li class="rail__item r-20" data-reveal>
              <a class="expertise" href={url(`/projects/expertises/${entry.id}`)}>
                <p class="expertise__index">{entry.data.index}</p>
                <h3 class="expertise__title">{entry.data.title}</h3>
                <div class="expertise__body">
                  <Content />
                </div>
                <span class="expertise__go" aria-hidden="true">
                  <svg width="15" height="11" viewBox="0 0 15 11" fill="none">
                    <path d="M0 5.5h13M8.5 1l4.5 4.5L8.5 10" stroke="currentColor" stroke-width="1.2" />
                  </svg>
                </span>
                <span class="visually-hidden">Voir les projets</span>
              </a>
            </li>
          ))
        }
      </ul>

      <button class="rail__nav rail__nav--prev" type="button" data-rail-prev hidden>
        <span class="visually-hidden">Colonnes précédentes</span>
        <svg width="11" height="18" viewBox="0 0 11 18" fill="none" aria-hidden="true">
          <path d="M9.5 1 1.5 9l8 8" stroke="currentColor" stroke-width="1.4" />
        </svg>
      </button>
      <button class="rail__nav rail__nav--next" type="button" data-rail-next>
        <span class="visually-hidden">Colonnes suivantes</span>
        <svg width="11" height="18" viewBox="0 0 11 18" fill="none" aria-hidden="true">
          <path d="M1.5 1l8 8-8 8" stroke="currentColor" stroke-width="1.4" />
        </svg>
      </button>
    </div>
  </section>

  {/* ---------------------------------------------------------- Process */}
  <section class="section" id="process">
    <div class="wrap">
      <Reveal>
        <SplitText as="h2" text={"Comment se déroule un projet\u00A0?"} class="title process__heading" />
      </Reveal>

      <div class="process">
        {
          process.map((step, i) => (
            <Reveal class="r-30">
              <details class:list={['step', { 'is-open': i === 0 }]} name="process" open={i === 0}>
                <summary class="step__summary">
                  <span class="step__index" aria-hidden="true">•</span>
                  <span class="step__title">{step.title}</span>
                  <span class="step__icon" aria-hidden="true" />
                </summary>
                <div class="step__panel">
                  <div class="step__inner">
                    <p class="lead">{step.body}</p>
                  </div>
                </div>
              </details>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  {/* --------------------------------------------------------- Showcase */}
  <section class="showcase">
    <div class="wrap">
      <Reveal>
        <div class="slider" data-slider>
          <div class="slider__track" data-slider-track>
            {
              showcase.map((p, i) => (
                <a class="slide" href={url(`/projects/${p.id}`)} data-slide aria-hidden={i > 0 ? 'true' : undefined}>
                  <Image
                    src={p.data.strip[0]}
                    alt={p.data.title}
                    widths={[800, 1280, 1920, 2560, 3200]}
                    quality={85}
                    sizes="(max-width: 809px) 96vw, 88vw"
                    loading="lazy"
                  />
                  <span class="slide__meta">
                    <span class="slide__title">{p.data.title}</span>
                    <span class="slide__services">/ {p.data.services.join(' / ')}</span>
                  </span>
                </a>
              ))
            }
          </div>

          <a class="slider__all link" href={url('/projects')}>
            Voir tous les projets
            <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
              <path d="M1 9L9 1M9 1H3M9 1v6" stroke="currentColor" stroke-width="1.2" />
            </svg>
          </a>

          <div class="slider__dots" role="tablist" aria-label="Projets mis en avant">
            {
              showcase.map((p, i) => (
                <button
                  class="slider__dot"
                  type="button"
                  role="tab"
                  data-slider-dot
                  aria-selected={i === 0 ? 'true' : 'false'}
                >
                  <span class="visually-hidden">{p.data.title}</span>
                </button>
              ))
            }
          </div>
        </div>
      </Reveal>
    </div>
  </section>
</Base>

<style>
  /* --- Hero -------------------------------------------------------------- */

  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100svh;
    padding-block: 8rem 7rem;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .hero__title {
    display: flex;
    flex-direction: column;
  }

  .hero__line { display: block; }

  .hero__sub {
    margin-top: clamp(1rem, 2vw, 1.5rem);
    font-size: clamp(0.75rem, 1.05vw, 0.9375rem);
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .badge {
    position: absolute;
    z-index: 1;
    left: 50%;
    bottom: clamp(2rem, 5vh, 3.5rem);
    translate: -50% 0;
    display: grid;
    place-items: center;
    width: 104px;
    height: 104px;
    color: var(--fg-muted);
    transition: color 0.4s var(--ease);
  }
  .badge:hover { color: var(--fg); }

  .badge__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: spin 18s linear infinite;
  }

  .badge__ring text {
    font-size: 8px;
    letter-spacing: 0.205em;
    text-transform: uppercase;
    fill: currentColor;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .badge__ring { animation: none; }
  }

  /* --- Grid -------------------------------------------------------------- */

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px;
  }

  @media (max-width: 760px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
  }

  /* --- Expertises rail --------------------------------------------------- */

  .expertises__hint {
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-dim);
  }

  .rail-wrap { position: relative; }

  .rail {
    display: flex;
    gap: 60px;
    padding-inline: var(--gutter);
    overflow-x: auto;
    /* No snapping: it would auto-scroll past the left gutter on load. */
    scrollbar-width: none;
    /* The last column bleeds off and fades, rather than being clipped. */
    -webkit-mask-image: linear-gradient(90deg, #000 82%, transparent 100%);
    mask-image: linear-gradient(90deg, #000 82%, transparent 100%);
  }
  .rail::-webkit-scrollbar { display: none; }

  .rail__item {
    /* 257px wide with a 60px gap, as measured on the original. */
    flex: 0 0 clamp(215px, 17.85vw, 300px);
  }

  .expertise {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    height: 350px;
  }

  .expertise__index {
    font-size: var(--fs-label);
    letter-spacing: 0.06em;
    color: var(--fg-dim);
    margin-bottom: 0.5rem;
  }

  .expertise__title {
    font-size: 1.0625rem;
    font-weight: 400;
    letter-spacing: -0.015em;
    margin-bottom: 1.15rem;
    transition: opacity 0.35s var(--ease);
  }

  .expertise__body {
    font-size: 0.875rem;
    font-weight: 300;
    line-height: 1.6;
    color: var(--fg-muted);
    flex: 1;
  }

  .expertise__body :global(p) { margin: 0; }

  /* A 32px round button holding a right arrow, as on the original. */
  .expertise__go {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin-top: auto;
    border-radius: 50%;
    background: var(--surface);
    color: var(--fg-muted);
    transition: background-color 0.35s var(--ease), color 0.35s var(--ease);
  }

  .expertise__go svg { transition: transform 0.45s var(--ease); }

  .expertise:hover .expertise__title { opacity: 0.6; }
  .expertise:hover .expertise__go { background: var(--surface-hover); color: var(--fg); }
  .expertise:hover .expertise__go svg { transform: translateX(3px); }

  .rail__nav {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: none;
    border: 0;
    color: var(--fg-muted);
    cursor: pointer;
    transition: color 0.3s var(--ease), opacity 0.3s var(--ease);
  }
  .rail__nav:hover { color: var(--fg); }
  .rail__nav[hidden] { display: none; }
  .rail__nav--prev { left: calc(var(--gutter) - 44px); }
  .rail__nav--next { right: calc(var(--gutter) - 30px); }

  @media (max-width: 809.98px) {
    .rail { -webkit-mask-image: none; mask-image: none; }
    .rail__nav { display: none; }
  }

  /* --- Process ----------------------------------------------------------- */

  .process__heading {
    max-width: 16ch;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .process { border-top: 1px solid var(--line-soft); }

  .step { border-bottom: 1px solid var(--line-soft); }

  .step__summary {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding-block: clamp(1.15rem, 2.2vw, 1.6rem);
    cursor: pointer;
    list-style: none;
    transition: color 0.3s var(--ease);
  }
  .step__summary::-webkit-details-marker { display: none; }
  .step__summary:hover { color: var(--fg); }

  .step__index {
    flex: none;
    font-size: 1rem;
    line-height: 1;
    color: var(--fg);
  }

  .step__title {
    flex: 1;
    font-size: clamp(1rem, 1.9vw, 1.4rem);
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .step__icon {
    position: relative;
    flex: none;
    width: 13px;
    height: 13px;
    color: var(--fg-muted);
  }
  .step__icon::before,
  .step__icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 1.4px;
    background: currentColor;
    transition: transform 0.4s var(--ease);
  }
  .step__icon::after { transform: rotate(90deg); }
  .step.is-open .step__icon::after { transform: rotate(0deg); }

  /* `grid-template-rows: 0fr -> 1fr` tweens to the content's own height with
     no measuring, which a paused compositor cannot get wrong. */
  .step__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.5s var(--spring-smooth);
  }

  .step.is-open .step__panel { grid-template-rows: 1fr; }

  .step__inner {
    overflow: hidden;
    padding-left: 1.5rem;
    max-width: 68ch;
  }

  .step__inner > p { padding-bottom: clamp(1.25rem, 2.5vw, 1.85rem); }

  @media (prefers-reduced-motion: reduce) {
    .step__panel { transition: none; }
  }

  @media (max-width: 809.98px) {
    .step__inner { padding-left: 0; }
  }

  /* --- Showcase slider --------------------------------------------------- */

  .showcase { padding-bottom: var(--section-y); }

  .slider { position: relative; }

  .slider__track {
    position: relative;
    /* 1265 x 793 on the original — not a letterbox. */
    aspect-ratio: 1265 / 793;
    overflow: hidden;
    background: var(--bg-raised);
    border-radius: 2px;
  }

  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s var(--spring-smooth);
  }

  .slide[data-active] {
    opacity: 1;
    pointer-events: auto;
  }

  .slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* The original holds the image slightly larger than its frame. */
    scale: 1.1;
  }

  .slide__meta {
    position: absolute;
    top: clamp(1rem, 2vw, 1.75rem);
    left: clamp(1rem, 2vw, 1.75rem);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: var(--fs-label);
    letter-spacing: 0.02em;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.5);
  }

  .slide__services { color: rgba(255, 255, 255, 0.72); }

  .slider__all {
    position: absolute;
    top: clamp(1rem, 2vw, 1.75rem);
    right: clamp(1rem, 2vw, 1.75rem);
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.5);
  }

  .slider__dots {
    position: absolute;
    left: 50%;
    bottom: 73px;
    translate: -50% 0;
    display: flex;
    gap: 8px;
  }

  .slider__dot {
    width: 28px;
    height: 6px;
    padding: 0;
    border: 0;
    background: rgba(255, 255, 255, 0.2);
    cursor: pointer;
    transition: background-color 0.4s var(--ease);
  }

  .slider__dot[aria-selected='true'] { background: var(--fg); }

  @media (max-width: 809.98px) {
    .slider__dots { bottom: 20px; }
  }

</style>

<script>
  /** Timers must not survive a client-side navigation. */
  let sliderTimer = 0;
  document.addEventListener('astro:before-swap', () => {
    if (sliderTimer) clearInterval(sliderTimer);
    sliderTimer = 0;
  });

  const init = () => {
  /* --- Process accordion --------------------------------------------------
     <details> drops its content the instant `open` goes away, so the element
     is kept open until the closing tween has run. ------------------------- */
  const steps = [...document.querySelectorAll<HTMLDetailsElement>('.step')];
  const CLOSE_MS = 520;
  const closeTimers = new WeakMap<HTMLDetailsElement, number>();

  const openStep = (step: HTMLDetailsElement) => {
    const pending = closeTimers.get(step);
    if (pending) { clearTimeout(pending); closeTimers.delete(step); }
    step.open = true;
    const grow = () => step.classList.add('is-open');
    requestAnimationFrame(() => requestAnimationFrame(grow));
    window.setTimeout(grow, 60);
  };

  const closeStep = (step: HTMLDetailsElement) => {
    step.classList.remove('is-open');
    closeTimers.set(
      step,
      window.setTimeout(() => {
        step.open = false;
        closeTimers.delete(step);
      }, CLOSE_MS)
    );
  };

  steps.forEach((step) => {
    if (step.open) step.classList.add('is-open');
    step.querySelector('.step__summary')?.addEventListener('click', (e) => {
      e.preventDefault();
      if (step.classList.contains('is-open')) {
        closeStep(step);
        return;
      }
      // Exclusive, like the original.
      steps.forEach((other) => other !== step && other.classList.contains('is-open') && closeStep(other));
      openStep(step);
    });
  });

  /* --- Expertises rail: wheel + arrow navigation --------------------------- */
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  const prev = document.querySelector<HTMLButtonElement>('[data-rail-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-rail-next]');

  if (rail) {
    const step = () => {
      const item = rail.querySelector<HTMLElement>('.rail__item');
      return item ? item.getBoundingClientRect().width : rail.clientWidth * 0.8;
    };

    const syncArrows = () => {
      const atStart = rail.scrollLeft <= 2;
      const atEnd = Math.ceil(rail.scrollLeft + rail.clientWidth) >= rail.scrollWidth - 2;
        prev?.toggleAttribute('hidden', atStart);
      next?.toggleAttribute('hidden', atEnd);
    };

    prev?.addEventListener('click', () => rail.scrollBy({ left: -step(), behavior: 'smooth' }));
    next?.addEventListener('click', () => rail.scrollBy({ left: step(), behavior: 'smooth' }));
    rail.addEventListener('scroll', syncArrows, { passive: true });
    window.addEventListener('resize', syncArrows, { passive: true });
    // Fonts and images settle after first paint and change scrollWidth.
    window.addEventListener('load', syncArrows, { once: true });
    syncArrows();

    if (window.matchMedia('(pointer: fine)').matches) {
      rail.addEventListener(
        'wheel',
        (e) => {
          if (Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return;
          const atStart = rail.scrollLeft <= 0;
          const atEnd = Math.ceil(rail.scrollLeft + rail.clientWidth) >= rail.scrollWidth;
          // Let the page keep scrolling once the rail reaches either end.
          if ((atStart && e.deltaY < 0) || (atEnd && e.deltaY > 0)) return;
          e.preventDefault();
          rail.scrollLeft += e.deltaY;
        },
        { passive: false }
      );
    }
  }

  /* --- Showcase slider ----------------------------------------------------- */
  const slider = document.querySelector<HTMLElement>('[data-slider]');

  if (slider) {
    const slides = [...slider.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...slider.querySelectorAll<HTMLButtonElement>('[data-slider-dot]')];
    const INTERVAL = 3000;
    let index = 0;

    const go = (i: number) => {
      index = (i + slides.length) % slides.length;
      slides.forEach((s, n) => {
        s.toggleAttribute('data-active', n === index);
        s.setAttribute('aria-hidden', n === index ? 'false' : 'true');
      });
      dots.forEach((d, n) => d.setAttribute('aria-selected', n === index ? 'true' : 'false'));
    };

    /* Still advances when motion is reduced — the cross-fade is what gets
       suppressed there, by the global transition override, not the rotation. */
    const play = () => {
      stop();
      sliderTimer = window.setInterval(() => go(index + 1), INTERVAL);
    };
    const stop = () => {
      if (sliderTimer) clearInterval(sliderTimer);
      sliderTimer = 0;
    };

    dots.forEach((d, n) =>
      d.addEventListener('click', () => {
        go(n);
        play();
      })
    );

    // Don't advance under the reader's cursor, or while the tab is hidden.
    slider.addEventListener('pointerenter', stop);
    slider.addEventListener('pointerleave', play);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : play()));

    go(0);
    play();
  }
  };

  /* Only via the event: ClientRouter fires `astro:page-load` on the first
     load as well as after each navigation. Calling init() directly too would
     bind every listener twice, and paired handlers would cancel each other. */
  document.addEventListener('astro:page-load', init);
</script>
