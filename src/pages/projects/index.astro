---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import FilterNav from '../../components/FilterNav.astro';
import Reveal from '../../components/Reveal.astro';
import { url } from '../../lib/url';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Tous les projets"
  description="Sélection de projets de direction artistique, identité visuelle, édition, packaging et illustration réalisés par ebs:projects.studio."
>
  <section class="page">
    <div class="wrap">
      <Reveal>
        <h1 class="title page__title">All projects</h1>
      </Reveal>

      <Reveal delay={0.05}>
        <FilterNav />
      </Reveal>

      <div class="grid">
        {
          projects.map((p, i) => (
            <Reveal delay={(i % 2) * 0.08}>
              <ProjectCard
                href={url(`/projects/${p.id}`)}
                title={p.data.title}
                services={p.data.services}
                image={p.data.cover}
                priority={i < 2}
                caption={false}
              />
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .page { padding-block: clamp(8rem, 15vh, 11rem) var(--section-y); }

  .page__title { margin-bottom: clamp(2rem, 4vw, 3rem); }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 4vw, 3.5rem) var(--gap);
  }

  @media (max-width: 760px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
