---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Reveal from '../../components/Reveal.astro';
import SplitText from '../../components/SplitText.astro';
import { serviceSlugs } from '../../data/site';
import { url } from '../../lib/url';

export const getStaticPaths = (async () => {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      // The three that follow, wrapping around the end of the list.
      related: [1, 2, 3].map((n) => projects[(i + n) % projects.length]),
    },
  }));
}) satisfies GetStaticPaths;

const { project, related } = Astro.props;
const { Content } = await render(project);
const { title, client, location, services, gallery, links } = project.data;

/** The strip runs the gallery twice so it can loop without a visible seam. */
const strip = [...gallery, ...gallery];
---

<Base title={title} description={`${title} — ${services.join(', ')}. Projet réalisé par ebs:projects.studio.`}>
  <article class="project">
    {/* --- Full-bleed strip, scrolling left at ~100px/s ------------------ */}
    <div class="strip" data-strip>
      <div class="strip__track" data-strip-track>
        {
          strip.map((img, i) => (
            <figure class="strip__item">
              <Image
                src={img}
                alt={i < gallery.length ? `${title} — visuel ${i + 1}` : ''}
                widths={[480, 960]}
                quality={72}
                sizes="(max-width: 809px) 60vw, 34vw"
                loading={i < 3 ? 'eager' : 'lazy'}
                aria-hidden={i >= gallery.length ? 'true' : undefined}
              />
            </figure>
          ))
        }
      </div>
    </div>

    {/* --- Meta block ---------------------------------------------------- */}
    <section class="wrap meta">
      <Reveal class="meta__side" data-on-mount>
        <div class="meta__group">
          <p class="label">Services</p>
          <ul>
            {
              services.map((s) => (
                <li>
                  {serviceSlugs[s] ? (
                    <a href={url(`/projects/expertises/${serviceSlugs[s]}`)}>{s}</a>
                  ) : (
                    <span>{s}</span>
                  )}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="meta__group">
          <p class="label">Client</p>
          <ul><li><span>{client}</span></li></ul>
        </div>
        <div class="meta__group">
          <p class="label">Location</p>
          <ul><li><span>{location}</span></li></ul>
        </div>
      </Reveal>

      <div class="meta__main">
        <SplitText as="h1" text={title} preset="meta2" class="meta__title" />
        <Reveal class="meta__info" data-on-mount>
          <p class="label">Info</p>
          <div class="meta__prose"><Content /></div>
        </Reveal>
      </div>

      {
        links.length > 0 && (
          <Reveal class="meta__side meta__side--right" data-on-mount>
            <div class="meta__group">
              <p class="label">Liens</p>
              <ul>
                {links.map((l) => (
                  <li>
                    <a href={l.url} target="_blank" rel="noopener noreferrer">{l.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          </Reveal>
        )
      }
    </section>

    {/* --- Gallery ------------------------------------------------------- */}
    <div class="wrap gallery">
      {
        gallery.map((img, i) => (
          <Reveal class="gallery__cell">
            <figure>
              <Image
                src={img}
                alt={`${title} — visuel ${i + 1}`}
                widths={[760, 1280, 1920]}
                quality={74}
                sizes="(max-width: 809px) 92vw, 46vw"
                loading="lazy"
              />
            </figure>
          </Reveal>
        ))
      }
    </div>
  </article>

  {/* --- Related --------------------------------------------------------- */}
  <section class="section related">
    <div class="wrap">
      <Reveal class="section-head">
        <SplitText as="h2" text="More projects" class="label" />
        <a class="link" href={url('/projects')}>
          See all works
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <path d="M1 9L9 1M9 1H3M9 1v6" stroke="currentColor" stroke-width="1.2" />
          </svg>
        </a>
      </Reveal>

      <div class="related__grid">
        {
          related.map((p, i) => (
            <Reveal delay={i * 0.06}>
              <ProjectCard
                href={url(`/projects/${p.id}`)}
                title={p.data.title}
                services={p.data.services}
                image={p.data.cover}
                variant="stacked"
                showServices
                sizes="(max-width: 809px) 92vw, 31vw"
              />
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .project { padding-top: 4.5rem; }

  /* --- Strip -------------------------------------------------------------- */

  .strip {
    overflow: hidden;
    width: 100%;
  }

  .strip__track {
    display: flex;
    gap: 4px;
    width: max-content;
    animation: strip-scroll var(--strip-duration, 60s) linear infinite;
  }

  .strip:hover .strip__track { animation-play-state: paused; }

  @keyframes strip-scroll {
    to { transform: translateX(-50%); }
  }

  .strip__item {
    margin: 0;
    height: clamp(220px, 30vw, 440px);
    flex: none;
  }

  .strip__item :global(img) {
    height: 100%;
    width: auto;
    max-width: none;
    object-fit: cover;
  }

  @media (prefers-reduced-motion: reduce) {
    .strip { overflow-x: auto; }
    .strip__track { animation: none; }
  }

  /* --- Meta --------------------------------------------------------------- */

  .meta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.55fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 3rem);
    padding-block: clamp(2.5rem, 5vw, 4rem) clamp(3rem, 6vw, 5.5rem);
  }

  .meta__side {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .meta__side--right { text-align: right; }

  .meta__group .label { margin-bottom: 0.85rem; }

  .meta__group ul {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    font-size: 0.9375rem;
  }

  .meta__group a {
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.4s var(--ease);
  }
  .meta__side--right .meta__group a { background-position: 100% 100%; }
  .meta__group a:hover { background-size: 100% 1px; }

  /* The project title is set at body scale here, not as a display heading. */
  .meta__title {
    display: block;
    font-size: clamp(0.9375rem, 1.2vw, 1.0625rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    margin-bottom: clamp(2rem, 4vw, 3.25rem);
  }

  .meta__info .label { margin-bottom: 0.6rem; }

  .meta__prose :global(p) {
    font-size: 0.9375rem;
    font-weight: 300;
    line-height: 1.6;
    color: var(--fg-muted);
    max-width: 64ch;
  }
  .meta__prose :global(p + p) { margin-top: 1em; }

  /* --- Gallery ------------------------------------------------------------ */

  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.2vw, 2rem);
    padding-bottom: var(--section-y);
  }

  .gallery figure {
    margin: 0;
    overflow: hidden;
    background: var(--bg-raised);
  }

  .gallery :global(img) {
    width: 100%;
    height: auto;
  }

  /* --- Related ------------------------------------------------------------ */

  .related { border-top: 1px solid var(--line-soft); }

  .related__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
  }

  @media (max-width: 1199.98px) {
    .meta { grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); }
    .meta__side--right { grid-column: 1 / -1; text-align: left; }
    .meta__side--right .meta__group a { background-position: 0 100%; }
  }

  @media (max-width: 809.98px) {
    .meta { grid-template-columns: minmax(0, 1fr); }
    .gallery { grid-template-columns: minmax(0, 1fr); }
    .related__grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script>
  /* The strip holds the gallery twice, so translating by -50% lands exactly
     back at the start. The duration is derived from the measured width so the
     speed stays at ~100px/s whatever the project's image count. */
  const init = () => {
  const strip = document.querySelector<HTMLElement>('[data-strip]');
  const track = document.querySelector<HTMLElement>('[data-strip-track]');

  if (strip && track) {
    const SPEED = 100;

    const setDuration = () => {
      const half = track.scrollWidth / 2;
      if (half > 0) strip.style.setProperty('--strip-duration', `${half / SPEED}s`);
    };

    setDuration();
    window.addEventListener('load', setDuration, { once: true });
    window.addEventListener('resize', setDuration, { passive: true });
  }
  };

  init();
  document.addEventListener('astro:page-load', init);
</script>
