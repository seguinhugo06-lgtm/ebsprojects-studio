---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Reveal from '../../components/Reveal.astro';
import SplitText from '../../components/SplitText.astro';
import { serviceSlugs } from '../../data/site';
import { url } from '../../lib/url';

export const getStaticPaths = (async () => {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      // The three that follow, wrapping around the end of the list.
      related: [1, 2, 3].map((n) => projects[(i + n) % projects.length]),
    },
  }));
}) satisfies GetStaticPaths;

const { project, related } = Astro.props;
const { Content } = await render(project);
const { title, client, location, services, strip, grid, links } = project.data;
---

<Base title={title} description={`${title} — ${services.join(', ')}. Projet réalisé par ebs:projects.studio.`}>
  <article class="project">
    {/* --- Clipped band: three images, centred, bleeding off both sides --- */}
    <div class="strip">
      <div class="strip__row">
        {
          strip.map((img, i) => (
            <figure class="strip__item">
              <Image
                src={img}
                alt={`${title} — visuel ${i + 1}`}
                widths={[500, 900, 1320, 1900]}
                quality={85}
                sizes="46vw"
                loading={i < 3 ? 'eager' : 'lazy'}
                data-fade
              />
            </figure>
          ))
        }
      </div>
    </div>

    {/* --- Meta block ---------------------------------------------------- */}
    <section class="wrap meta">
      <Reveal class="meta__side" data-on-mount>
        <div class="meta__group">
          <p class="label">Services</p>
          <ul>
            {
              services.map((s) => (
                <li>
                  {serviceSlugs[s] ? (
                    <a href={url(`/projects/expertises/${serviceSlugs[s]}`)}>{s}</a>
                  ) : (
                    <span>{s}</span>
                  )}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="meta__group">
          <p class="label">Client</p>
          <ul><li><span>{client}</span></li></ul>
        </div>
        <div class="meta__group">
          <p class="label">Location</p>
          <ul><li><span>{location}</span></li></ul>
        </div>
      </Reveal>

      <div class="meta__main">
        <SplitText as="h1" text={title} preset="meta2" class="meta__title" />
        <Reveal class="meta__info" data-on-mount>
          <p class="label">Info</p>
          <div class="meta__prose"><Content /></div>
        </Reveal>
      </div>

      {
        links.length > 0 && (
          <Reveal class="meta__side meta__side--right" data-on-mount>
            <div class="meta__group">
              <p class="label">Liens</p>
              <ul>
                {links.map((l) => (
                  <li>
                    <a href={l.url} target="_blank" rel="noopener noreferrer">{l.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          </Reveal>
        )
      }
    </section>

    {/* --- Grid: spans and crop ratios as measured on the original ------ */}
    <div class="wrap grid">
      {
        grid.map((slot, i) => (
          <Reveal class={`grid__cell grid__cell--${slot.span}`}>
            <figure style={`aspect-ratio:${slot.ratio}`}>
              <Image
                src={slot.src}
                alt={`${title} — visuel ${i + 1}`}
                widths={slot.span === 'full' ? [800, 1280, 1920, 2560, 3200] : [500, 800, 1240, 1800, 2400]}
                quality={85}
                sizes={
                  slot.span === 'full'
                    ? '(max-width: 809px) 96vw, 88vw'
                    : '(max-width: 809px) 96vw, 43vw'
                }
                loading="lazy"
                data-fade
              />
            </figure>
          </Reveal>
        ))
      }
    </div>
  </article>

  {/* --- Related --------------------------------------------------------- */}
  <section class="section related">
    <div class="wrap">
      <Reveal class="section-head">
        <SplitText as="h2" text="More projects" class="label" />
        <a class="link" href={url('/projects')}>
          See all works
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <path d="M1 9L9 1M9 1H3M9 1v6" stroke="currentColor" stroke-width="1.2" />
          </svg>
        </a>
      </Reveal>

      <div class="related__grid">
        {
          related.map((p, i) => (
            <Reveal delay={i * 0.06}>
              <ProjectCard
                href={url(`/projects/${p.id}`)}
                title={p.data.title}
                services={p.data.services}
                image={p.data.cover}
                variant="related"
                sizes="(max-width: 809px) 96vw, 29vw"
              />
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .project { padding-top: 4.5rem; }

  /* --- Strip -------------------------------------------------------------- */

  .strip {
    /* The row is wider than the page and is clipped on both sides. */
    overflow: clip;
    width: 100%;
  }

  .strip__row {
    display: flex;
    justify-content: center;
    gap: 20px;
    /* Wider than the page: centring makes it bleed off both sides equally. */
    width: 100%;
  }

  .strip__item {
    margin: 0;
    flex: none;
    width: clamp(240px, 45.4vw, 900px);
    aspect-ratio: 654 / 429;
    background: var(--bg-raised);
  }

  .strip__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* --- Meta --------------------------------------------------------------- */

  .meta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.55fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 3rem);
    padding-block: clamp(2.5rem, 5vw, 4rem) clamp(3rem, 6vw, 5.5rem);
  }

  .meta__side {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .meta__side--right { text-align: right; }

  .meta__group .label { margin-bottom: 0.85rem; }

  .meta__group ul {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    font-size: 0.9375rem;
  }

  .meta__group a {
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.4s var(--ease);
  }
  .meta__side--right .meta__group a { background-position: 100% 100%; }
  .meta__group a:hover { background-size: 100% 1px; }

  /* The project title is set at body scale here, not as a display heading. */
  .meta__title {
    display: block;
    font-size: clamp(0.9375rem, 1.2vw, 1.0625rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    margin-bottom: clamp(2rem, 4vw, 3.25rem);
  }

  .meta__info .label { margin-bottom: 0.6rem; }

  .meta__prose :global(p) {
    font-size: 0.9375rem;
    font-weight: 300;
    line-height: 1.6;
    color: var(--fg-muted);
    max-width: 64ch;
  }
  .meta__prose :global(p + p) { margin-top: 1em; }

  /* --- Grid --------------------------------------------------------------- */

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px;
    padding-bottom: var(--section-y);
  }

  .grid__cell--full { grid-column: 1 / -1; }

  .grid figure {
    margin: 0;
    overflow: hidden;
    background: var(--bg-raised);
  }

  .grid :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* --- Related ------------------------------------------------------------ */

  .related { border-top: 1px solid var(--line-soft); }

  .related__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  @media (max-width: 1199.98px) {
    .meta { grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); }
    .meta__side--right { grid-column: 1 / -1; text-align: left; }
    .meta__side--right .meta__group a { background-position: 0 100%; }
  }

  @media (max-width: 809.98px) {
    .meta { grid-template-columns: minmax(0, 1fr); }
    .grid { grid-template-columns: minmax(0, 1fr); }
    .grid__cell--full { grid-column: auto; }
    .related__grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
