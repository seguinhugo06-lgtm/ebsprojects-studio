---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, contact, socials } from '../data/site';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative image used for social previews. */
  image?: string;
  /** Set on pages that should not be indexed. */
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  image = '/brand/og-image.png',
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.description}`;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', site.url).href;
const ogImage = new URL(image, site.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  description: site.description,
  url: site.url,
  image: ogImage,
  email: contact.email,
  telephone: contact.phone,
  founder: { '@type': 'Person', name: contact.name, jobTitle: contact.role },
  address: {
    '@type': 'PostalAddress',
    addressLocality: contact.city,
    addressCountry: 'FR',
  },
  areaServed: 'FR',
  sameAs: socials.map((s) => s.url),
};
---

<!doctype html>
<html lang={site.lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href={url('/brand/favicon-dark.png')} media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={url('/brand/favicon-light.png')} media="(prefers-color-scheme: light)" />
    <link rel="apple-touch-icon" href={url('/brand/favicon-light.png')} />
    <meta name="theme-color" content="#161616" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={site.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    <script is:inline>
      // Flip before paint so reveal animations only apply when JS can undo them.
      document.documentElement.classList.remove('no-js');
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <a class="skip-link" href="#main">Aller au contenu</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      /**
       * Reveal system, mirroring the original Framer build.
       *
       * Two triggers: `data-on-mount` groups play on load, everything else
       * plays when it reaches the viewport. Elements split with
       * `tokenization="line"` get their stagger index assigned here, by
       * grouping tokens on the same visual line — the same thing Framer's
       * `bm()` does with offsetTop.
       *
       * Deliberately a geometric sweep rather than an IntersectionObserver:
       * tokens start at `opacity: .001`, so anything that stops an observer
       * from reporting (a hidden tab, an embedded webview, a zero-height
       * viewport) would leave the page blank for good.
       */
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const all = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];

      /** Assign one stagger index per visual line. */
      const groupLines = (el: HTMLElement) => {
        const toks = [...el.querySelectorAll<HTMLElement>('.tok')];
        if (!toks.length) return;
        let line = 0;
        let top: number | null = null;
        for (const tok of toks) {
          const y = tok.offsetTop;
          if (top !== null && y !== top) line++;
          top = y;
          tok.style.setProperty('--i', String(line));
        }
      };

      all.forEach((el) => {
        if (el.dataset.tokenization === 'line') groupLines(el);
      });

      const show = (el: HTMLElement) => el.classList.add('is-visible');

      if (reduced) {
        all.forEach(show);
      } else {
        const onMount = all.filter((el) => el.dataset.onMount !== undefined);
        const onScroll = new Set(all.filter((el) => el.dataset.onMount === undefined));

        // Let the first paint settle so the transition actually runs. The
        // timeout is a fallback: rAF does not fire in a hidden tab, and the
        // on-load groups must not be left stuck at opacity 0 either way.
        let mounted = false;
        const playOnMount = () => {
          if (mounted) return;
          mounted = true;
          onMount.forEach(show);
        };
        requestAnimationFrame(() => requestAnimationFrame(playOnMount));
        window.setTimeout(playOnMount, 200);

        let lastRun = 0;
        let timer = 0;

        const sweep = () => {
          lastRun = performance.now();
          const limit = window.innerHeight * 0.92;
          onScroll.forEach((el) => {
            if (el.getBoundingClientRect().top < limit) {
              show(el);
              onScroll.delete(el);
            }
          });
          if (onScroll.size === 0) teardown();
        };

        /* Time-throttled rather than rAF-driven on purpose: rAF is paused in
           background tabs and throttled by some embedded webviews, which would
           strand every token below the fold at opacity 0. */
        const onEvent = () => {
          const since = performance.now() - lastRun;
          if (since >= 80) {
            sweep();
          } else if (!timer) {
            timer = window.setTimeout(() => { timer = 0; sweep(); }, 80 - since);
          }
        };

        function teardown() {
          window.removeEventListener('scroll', onEvent);
          window.removeEventListener('resize', onEvent);
          if (timer) { clearTimeout(timer); timer = 0; }
        }

        window.addEventListener('scroll', onEvent, { passive: true });
        window.addEventListener('resize', onEvent, { passive: true });
        sweep();
        // Late fonts and images shift layout; re-measure lines and re-check.
        window.addEventListener('load', () => {
          all.forEach((el) => { if (el.dataset.tokenization === 'line') groupLines(el); });
          onEvent();
        }, { once: true });
      }
    </script>
  </body>
</html>
